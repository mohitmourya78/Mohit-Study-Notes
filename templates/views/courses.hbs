<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MohitNotes-Check New Subject's</title>
    <link rel="shortcut icon" href="public/img/mn-initial-letters-logo-design-free-vector.jpg" type="image/x-icon">


{{>homecss}}

</head>

<body>
  
    <nav class="navbar respnavh">
        <div class="logo">
            <a href="home"><img src="img/mn-initial-letters-logo-design-free-vector.jpg" alt="logo"></a>
        </div>

        <ul class="navlist respnavv">

            <li><a href="/">Home</a></li>
            <li><a href="about">About</a></li>
            <li><a href="contactt">Contact Us</a></li>
            <li><a href="blog">Blog</a></li>
            <li><a href="/courses">Courses</a></li>
            <li class="menu-item dropdown"><a>Tutorial &dtrif;</a>
                <ul class="dropdown">
                    <li><a href="#">Web Devlopment</a></li>
                    <li><a href="#">Full Stack Development</a></li>
                    <li><a href="#">Fronted Devlopment</a></li>
                    <li><a href="#">Data Analytics</a></li>
                    <li><a style="color: blue;" href="/courses">More</a></li>
                  </ul>
            </li>
            <li><a href="/notes">Notes</a></li>
            <li><a href="">Work With Us</a></li>

        </ul>

        <div class="burger" id= "burger">
            <div class="line"></div>
            <div class="line"></div>
            <div class="line"></div>
        </div>
        
        <div class="rightnav">
            <div class="logsign" id="authLinks">

              

            <div class="logsign" id="authLinks">
                {{#if isLoggedIn}}
                    <li class="login account" id="logout"><a href="/logout">Log Out</a></li>
                {{else}}
                    <div id="loginacc" style="display:flex; gap:5px;">
                        <li class="login account"><a href="/login" target="_blank">Log In</a></li>
                        <li class="signup account"><a href="/register" target="_blank">Sign Up</a></li>
                    </div>
                {{/if}}
            </div>
        </div>
            <div class="search-container" id="search-container">
                <input type="text" placeholder="Search.." class="search-input" id="search-input">
                <div class="search-icon" id="search-icon" onclick="searchwarning()">
                    <!-- You can use any search icon here -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                        <path
                            d="M20.7 19l-5.2-5.2c1.2-1.4 1.9-3.3 1.9-5.3 0-4.4-3.6-8-8-8s-8 3.6-8 8 3.6 8 8 8c2 0 3.9-0.7 5.3-1.9l5.2 5.2c0.4 0.4 1 0.4 1.4 0 0.4-0.4 0.4-1 0-1.4zM4 10c0-3.3 2.7-6 6-6s" />
                    </svg>
                </div>
            </div> 
        </div>
     
    </nav>
    <button id="scrollToTopBtn" class="scroll-to-top-btn">&#x2191;</button>


    <section id="scrollTarget" class=" heading2">
        <span> <img src="img/564445.png" alt="notes">
            Start Free Courses By Dank Mohit</span>

        <div class="grid">
            
            {{#each courses}}

    <div class="item" data-name="{{this.name}}">
        {{#if this.image_url}}
            <img src="{{this.image_url}}" alt="{{this.name}} image" class="service-image courses-img" />
        {{/if}}
        <div class="item-sub">
            {{this.name}}
        </div>
        <p> ({{this.description}})</p>
        <p>{{this.status}}</p>
        <a href="{{this.watch_link}}" style="text-decoration: none" class="secbtn">Start Watching</a>
    </div>
    {{/each}}
           
            
        </div> 
    </section>

    {{>footer}}

    <script>

    
        const burger = document.querySelector('.burger')
        const navbar = document.querySelector('.navbar')
        const navList = document.querySelector('.navlist')
    
    
    burger.addEventListener('click',()=>{
        navList.classList.toggle('respnavv');
        navbar.classList.toggle('respnavh');
    
    })

    document.addEventListener('DOMContentLoaded', () => {
        const scrollToTopBtn = document.getElementById('scrollToTopBtn');
      
        window.addEventListener('scroll', () => {
          if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
            scrollToTopBtn.style.display = 'block'; 
          } else {
            scrollToTopBtn.style.display = 'none'; 
          }
        });
      
        scrollToTopBtn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth' // Smooth scroll to the top
          });
        });
      });
    
    </script>
    
</body>