<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MohitNotes-Check New Subject's</title>
    <link rel="shortcut icon" href="public/img/mn-initial-letters-logo-design-free-vector.jpg" type="image/x-icon">


{{>homecss}}

</head>

<body>
  {{>navbar}}

    <div class="seperation-line"></div>

    <section id="scrollTarget" class=" heading2">
        <span> <img src="img/564445.png" alt="notes">
            Recommended Notes</span>

        <div class="grid">
            
            {{#each services}}

    <div class="item" data-name="{{this.name}}">
        {{#if this.image_url}}
            <img src="{{this.image_url}}" alt="{{this.name}} image" class="service-image" />
        {{/if}}
        <div class="item-sub">
            {{this.name}} Notes
        </div>
        <p> ({{this.description}})</p>
        <p>{{this.status}}</p>
        <a href="{{this.download_link}}" style="text-decoration: none" class="secbtn">Download</a>
        <a href="{{this.view_link}}" style="text-decoration: none" class="secbtn view-link">View Notes</a>
    </div>
    {{/each}}
           
            
        </div> 
    </section>
    <br>
    <br>

    <div class="seperation-line"></div>

    <section id="scrollTarget" class=" heading2">
        <span> <img src="img/564445.png" alt="notes">
            Start Free Courses By Dank Mohit</span>

        <div class="grid">
            
            {{#each courses}}

    <div class="item" data-name="{{this.name}}">
        {{#if this.image_url}}
            <img src="{{this.image_url}}" alt="{{this.name}} image" class="service-image courses-img" />
        {{/if}}
        <div class="item-sub">
            {{this.name}}
        </div>
        <p> ({{this.description}})</p>
        <p>{{this.status}}</p>
        <a href="{{this.watch_link}}" style="text-decoration: none" class="secbtn">Start Watching</a>
    </div>
    {{/each}}
           
            
        </div> 
    </section>


    {{>footer}}
    
  <script>

    function redirectToGrid() {
        window.location.href = "home#scrollTarget";
    }

    const burger = document.querySelector('.burger')
    const navbar = document.querySelector('.navbar')
    const navList = document.querySelector('.navlist')


burger.addEventListener('click',()=>{
    navList.classList.toggle('respnavv');
    navbar.classList.toggle('respnavh');

})
    document.getElementById("fstbtn").addEventListener("click", function() {
        const scrollTarget = document.getElementById("scrollTarget");
        scrollTarget.scrollIntoView({ behavior: "smooth", block:"start" });
    });
    
    
    const token = localStorage.getItem('token');

    if (token) {
        localStorage.setItem('token', token);
    }

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('alert')) {
        alert("Your session has expired. Please log in again to continue.");
    }


    console.log("Token from localStorage: ", token); 
    const viewLinks = document.querySelectorAll('.view-link');

    viewLinks.forEach(link => {
        if (!token) {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                alert('You need to log in to access this page.');  
                window.location.href = '/login';  
            });
        } else {
            console.log("User is logged in. Link will work.");
        }
    });

    if (token) {
        localStorage.setItem('token', token);
    }



   
</script>




</body>

</html>